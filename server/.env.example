# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/template

# Auth
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=propguard_access_token

# Server
APP_NAME=Blockchain Property Verification API
HOST=0.0.0.0
PORT=8000

# Frontend origin allowed to call this API (comma-separated)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ledger signing (simulated land-registry key). Generate with:
#   PYTHONPATH=. .venv/bin/python scripts/generate_registry_key.py >> .env
# Then rebuild ledger hashes so every block is re-signed. Never commit the private key.
REGISTRY_CONTRACT_ADDRESS=0x70726f7067756172642d72656769737472790001
REGISTRY_SIGNING_KEY=
REGISTRY_PUBLIC_KEY=

# AI / LLM (Report Agent, natural-language search)
# Set AI_ENABLED=true after filling AI_API_KEY and confirming AI_MODEL.
AI_ENABLED=false
AI_PROVIDER=gemini
# gemini | openai | ollama
AI_API_KEY=
# Gemini examples: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
# OpenAI examples: gpt-4o-mini, gpt-4o
# Ollama examples: llama3.2, mistral
AI_MODEL=gemini-2.0-flash
# Optional override (OpenAI-compatible proxy or Ollama, e.g. http://localhost:11434)
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60
