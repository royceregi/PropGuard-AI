# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/template

# Auth
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=propguard_access_token

# Server
APP_NAME=Blockchain Property Verification API
HOST=0.0.0.0
PORT=8000

# Frontend origin allowed to call this API (comma-separated)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
