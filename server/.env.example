# =============================================================================
# PropGuard AI — Backend environment
# =============================================================================
# Create your .env (from server/):
#   make env                     copies this file and generates SECRET_KEY
#   make env ARGS=--registry-key also generates the ledger signing key pair
# Then edit .env: at minimum set DATABASE_URL.
#
# REQUIRED = the API will not start without it. Everything else has a default.
# Never commit .env — it holds secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Database (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL connection with the fully migrated `core` schema.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/property_db


# -----------------------------------------------------------------------------
# 2. Authentication (SECRET_KEY is REQUIRED)
# -----------------------------------------------------------------------------
# Signs the login JWTs. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# How long a login stays valid (480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Name of the cookie that carries the token
AUTH_COOKIE_NAME=propguard_access_token


# -----------------------------------------------------------------------------
# 3. Server and frontend
# -----------------------------------------------------------------------------
APP_NAME=Blockchain Property Verification API
# Informational only: `make dev` always serves on 0.0.0.0:8000
HOST=0.0.0.0
PORT=8000
# Frontend URL (also sent to OpenRouter as the request referer)
FRONTEND_URL=http://localhost:3000
# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# -----------------------------------------------------------------------------
# 4. Blockchain ledger signing (optional)
# -----------------------------------------------------------------------------
# Simulated land-registry smart contract address
REGISTRY_CONTRACT_ADDRESS=0x70726f7067756172642d72656769737472790001
# Ed25519 key pair (hex). Leave empty to skip writing/checking signatures.
# Generate:  PYTHONPATH=. .venv/bin/python scripts/generate_registry_key.py
# After setting or changing the key, rebuild the ledger hashes (Settings page)
# so every block is re-signed. Keep the private key secret.
REGISTRY_SIGNING_KEY=
REGISTRY_PUBLIC_KEY=


# -----------------------------------------------------------------------------
# 5. AI / LLM (optional — the app works without it)
# -----------------------------------------------------------------------------
# Turn LLM-written explanations and reports on/off
AI_ENABLED=false
# Provider: gemini | openai | ollama | openrouter
AI_PROVIDER=openrouter
AI_API_KEY=
# Custom endpoint (OpenRouter: https://openrouter.ai/api/v1,
# Ollama: http://localhost:11434). Leave empty for the provider default.
AI_BASE_URL=https://openrouter.ai/api/v1

# Models (OpenRouter IDs shown; change them if you use another provider).
# AI_MODEL is the fallback for any agent model left empty.
AI_MODEL=google/gemini-2.5-flash
AI_RETRIEVAL_MODEL=google/gemini-2.5-flash-lite
AI_TRANSACTION_ANALYSIS_MODEL=google/gemini-2.5-flash
AI_RISK_MODEL=deepseek/deepseek-chat-v3-0324
AI_REPORT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Generation settings
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60


# -----------------------------------------------------------------------------
# 6. Anomaly detection model (optional)
# -----------------------------------------------------------------------------
# Isolation Forest over transaction features. Skipped if the model file is missing.
# Train:  PYTHONPATH=. .venv/bin/python scripts/train_anomaly_model.py
ANOMALY_MODEL_ENABLED=true
ANOMALY_MODEL_PATH=models/anomaly_isolation_forest.joblib
# Expected share of anomalous transactions (0.01 = 1%)
ANOMALY_CONTAMINATION=0.01
