# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/template

# Auth
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=propguard_access_token

# Server
APP_NAME=Blockchain Property Verification API
HOST=0.0.0.0
PORT=8000

# Frontend origin allowed to call this API (comma-separated)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ledger signing (simulated land-registry key). Generate with:
#   PYTHONPATH=. .venv/bin/python scripts/generate_registry_key.py >> .env
# Then rebuild ledger hashes so every block is re-signed. Never commit the private key.
REGISTRY_CONTRACT_ADDRESS=0x70726f7067756172642d72656769737472790001
REGISTRY_SIGNING_KEY=
REGISTRY_PUBLIC_KEY=

# AI / LLM
# AI_MODEL is the fallback. Override it independently for each agent as needed.
AI_ENABLED=false
AI_PROVIDER=openrouter
# gemini | openai | ollama | openrouter
AI_API_KEY=
# The following examples use OpenRouter model IDs. Change all five values if using
# another provider, and keep AI_MODEL as the compatibility fallback.
AI_MODEL=google/gemini-2.5-flash
# Retrieval and transaction analysis remain deterministic by design; these settings
# identify the model to use if LLM-assisted capabilities are enabled for those agents.
AI_RETRIEVAL_MODEL=google/gemini-2.5-flash-lite
AI_TRANSACTION_ANALYSIS_MODEL=google/gemini-2.5-flash
AI_RISK_MODEL=deepseek/deepseek-chat-v3-0324
AI_REPORT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional override (OpenAI-compatible proxy or Ollama, e.g. http://localhost:11434)
# For OpenRouter, use: https://openrouter.ai/api/v1
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60
